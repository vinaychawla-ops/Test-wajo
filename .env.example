# Port the server listens on
PORT=3000

# Vision provider used to read handwriting off the submitted photo.
# Any OpenAI-compatible endpoint works (OpenAI, Azure OpenAI, OpenRouter, a local vLLM...).
# Leave VISION_API_KEY empty to run in mock mode: the app still works end to end,
# it just invents plausible answers instead of reading the photo.
VISION_API_KEY=
VISION_BASE_URL=https://api.openai.com/v1
VISION_MODEL=gpt-4o-mini

# Teacher pages are protected by this passphrase. Students never need it.
TEACHER_PASSCODE=change-me
